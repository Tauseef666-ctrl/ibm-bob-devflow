# DevFlow AI frontend — Vite environment variables
# Copy to .env.local for local development overrides.
#
# Vite inlines VITE_* variables at BUILD time, so a change here requires a
# rebuild, not just a redeploy of the API.

# Absolute origin of the backend, with no trailing slash and no /api suffix.
# The client appends /api itself.
#
# Leave this UNSET for a combined deployment, where the SPA and the API share
# one origin and the client falls back to the relative path /api.
# VITE_API_URL=https://your-backend.example.com
#
# Set it only when the frontend is a separate project from the API. Doing so
# also makes the request cross-origin, so the backend needs a matching
# FRONTEND_URL for its CORS allowlist (see backend/.env.example).
